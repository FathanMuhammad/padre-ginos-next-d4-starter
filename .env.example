# Copy to .env.local and fill in. Never commit .env.local.

# 32+ random characters. Generate: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_PASSWORD=

# Your own GitHub OAuth App (github.com/settings/developers → New OAuth App)
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Classroom only: shows "masuk sebagai demo user" on /login.
# NEVER set this on a deployed server.
AUTH_DEV_LOGIN=1

# Optional (Day 1–2): artificial latency in ms
# DEMO_READ_LATENCY_MS=300
# DEMO_WRITE_LATENCY_MS=800
